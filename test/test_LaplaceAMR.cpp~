#define PI 3.1415926535897

using namespace std;

double sol_u(double x, double y, double t) { 
  return (sin(2.0 * PI * x) * sin(2.0 * PI * y));
}

double Dif(double x, double y){
  return 1.0;
}

double f_rhs(double x, double y) {
  return (8.0 * PI * PI * sin(2.0 * PI * x) * sin(2.0 * PI * y));
}


